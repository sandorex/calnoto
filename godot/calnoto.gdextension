[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64   = "res://target/debug/libcalnoto.so"
linux.release.x86_64 = "res://target/release/libcalnoto.so"

android.debug.arm64 = "res://target/aarch64-linux-android/debug/libcalnoto.so"
android.release.arm64 = "res://target/aarch64-linux-android/release/libcalnoto.so"

